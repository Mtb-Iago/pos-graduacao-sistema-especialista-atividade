# =====================================================================
# MTBExpert — Configuração Geral de Ambiente (Docker Compose)
# =====================================================================

# Chave da API Google Gemini (Google AI Studio)
# Necessária para raciocínio generativo aberto e para o avaliador LLM-as-a-Judge.
# Obtenha gratuitamente em: https://aistudio.google.com/
GEMINI_API_KEY=sua_chave_gemini_aqui

# Modelo Gemini a ser utilizado (padrão: gemini-flash-latest ou gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# Modelo do Juiz Automatizado (LLM-as-a-Judge)
JUDGE_MODEL=gemini-3.5-flash-lite

# Limiar de similaridade de cosseno para o Cache Semântico vetorial (pgvector)
CACHE_THRESHOLD=0.65
